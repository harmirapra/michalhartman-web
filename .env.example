# Šablona proměnných prostředí. Zkopíruj na .env a doplň reálné hodnoty.
# .env NIKDY nepatří do gitu.

# Etapa 1 (statický web) žádné proměnné nepotřebuje.

# Etapa 2 (trvalý disk a příjem fotek):
# Cesta k datovému adresáři. V Railway je tam připojený disk (volume).
# Lokálně a v náhledu PR bez připojeného disku klidně zůstane výchozí —
# server si adresář vytvoří na dočasném souborovém systému kontejneru.
DATA_DIR=/data

# Token pro /admin/* (hlavička Authorization: Bearer <token>). Bez něj
# server /admin/* vůbec nezpřístupní. NIKDY sem nepiš skutečnou hodnotu.
ADMIN_TOKEN=
