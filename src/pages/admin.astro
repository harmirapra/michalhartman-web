		padding: 0 0 var(--mezera-2);
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}

	.admin-tab[aria-current="true"] {
		color: var(--barva-textu);
		border-bottom-color: var(--barva-textu);
	}

	/* --- Stat dlaždice (Obrazovka 2) ---
	   Chyba (červená, --barva-zvyrazneni) vs. upozornění (tlumená varianta,
	   --barva-akcent-tlumeny) se tu vědomě zobrazují na jedné obrazovce
	   současně — DESIGN.md sekci 3 (žádné dva akcenty pohromadě) je to
	   výjimka: bez ní by tahle diagnostická obrazovka nedokázala ukázat
	   rozdíl mezi "chybou" a "jen se podívej", což zadání fáze 7 výslovně
	   žádá (souhrn: "Obrazovka nesmí tvrdit jistotu, kterou nemá"). */
	.admin-staty {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
