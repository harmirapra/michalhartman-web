	}

	.admin-stat--spatne .admin-stat-n {
		color: var(--barva-zvyrazneni);
	}

	.admin-stat--upozorneni .admin-stat-n {
		color: var(--barva-akcent-tlumeny);
	}

	/* --- Panely (sekce se seznamy) --- */

	.admin-panel {
