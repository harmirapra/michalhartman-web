---
import Base from "../layouts/Base.astro";
import MediaGalerie from "../components/MediaGalerie.astro";
---

<Base
	title="Skotsko – Michal Hartman"
	description="Fotografie ze Skotska — hory, hrady a pobřeží Vysočiny a ostrovů."
>
	<main class="bez-hero">
		<h1 class="vizualne-skryty">Skotsko</h1>

		<p class="drobecky">
			<span class="odkaz-vzhled">Galerie</span><span class="sip">»</span>Skotsko
		</p>

		<MediaGalerie klicoveSlovo="Scotland" layout="radky" />
	</main>
</Base>
