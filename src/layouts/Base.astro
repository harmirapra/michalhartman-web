---
import "@fontsource/poppins/latin-ext-200.css";
import "@fontsource/poppins/latin-ext-300.css";
import "@fontsource/poppins/200.css";
import "@fontsource/poppins/300.css";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;

const cesta = Astro.url.pathname;
const jeAktivni = (href: string) => cesta === href;
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<header class="hlavicka">
			<a class="znacka" href="/">Michal Hartman</a>
			<nav id="mobilni-navigace" class="navigace" aria-label="Hlavní navigace">
				<a href="/" aria-current={jeAktivni("/") ? "page" : undefined}>Úvod</a>
				<span class="odkaz-vzhled">Galerie</span>
				<a href="/about/" aria-current={jeAktivni("/about/") ? "page" : undefined}>O mně</a>
				<div class="jazyky">
					<span class="odkaz-vzhled aktivni">CZ</span>
					<span class="jazyky-oddelovac">/</span>
					<span class="odkaz-vzhled">EN</span>
				</div>
			</nav>
			<button
				type="button"
				class="hamburger"
				aria-expanded="false"
				aria-controls="mobilni-navigace"
				aria-label="Otevřít navigaci"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</header>

		<slot />

		<footer class="paticka">
			<span>© 2026 Michal Hartman</span>
			<span class="paticka-oddelovac">|</span>
			<span class="odkaz-vzhled">Ochrana osobních údajů</span>
			<span class="paticka-oddelovac">|</span>
			<span class="odkaz-vzhled">Nastavení cookies</span>
			<span class="paticka-oddelovac">|</span>
			<span class="odkaz-vzhled">Impressum</span>
			<span class="odkaz-vzhled paticka-facebook" aria-label="Facebook">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M15 8.5h-2a1 1 0 0 0-1 1V11h3l-.4 3H12v7h-3v-7H7v-3h2V9a4 4 0 0 1 4-4h2z"></path>
				</svg>
			</span>
		</footer>

		<script>
			const tlacitko = document.querySelector(".hamburger");
			const navigace = document.querySelector(".navigace");

			if (tlacitko && navigace) {
				tlacitko.addEventListener("click", () => {
					const otevreno = navigace.classList.toggle("otevrena");
					tlacitko.setAttribute("aria-expanded", String(otevreno));
				});

				document.addEventListener("click", (event) => {
					if (!navigace.classList.contains("otevrena")) return;
					const cil = event.target as Node;
					if (navigace.contains(cil) || tlacitko.contains(cil)) return;
					navigace.classList.remove("otevrena");
					tlacitko.setAttribute("aria-expanded", "false");
				});
			}
		</script>
	</body>
</html>
