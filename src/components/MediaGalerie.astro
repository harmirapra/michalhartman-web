---
// Komponenta galerie — NEVYKRESLUJE se při buildu. Astro vygeneruje jen
// prázdný kontejner s parametry v data-* atributech; klientský skript (níže)
// si po načtení stránky vyzvedne aktuální /api/index.json, vyfiltruje fotky
// podle klíčového slova a poskládá mřížku. Díky tomu se nová fotka objeví
// v galerii hned po nahrání na server, bez nového buildu/deploye — to je
// celý smysl architektury (viz zadání fáze 5).
//
// Layout „radky" je zatím jediný, který existuje — ostatní (mrizka, zdivo,
// mozaika, karusel) se přidají, až je bude nějaká galerie potřebovat.

interface Props {
	klicoveSlovo: string;
	layout?: "radky";
	/** Popisek fotky pod náhledem — na stránce galerie vypnutý (rozhodnutí B1),
	 * zapne se na rozcestníku ve fázi 6. */
	popisky?: boolean;
}

const { klicoveSlovo, layout = "radky", popisky = false } = Astro.props;
---

<div
	class="media-galerie"
	data-klicove-slovo={klicoveSlovo}
	data-layout={layout}
	data-popisky={popisky ? "true" : "false"}
>
</div>

<script>
	import PhotoSwipeLightbox from "photoswipe/lightbox";
	import "photoswipe/style.css";
	import {
		jeZobrazitelna,
		nacistIndex,
		odpovidaKlicovemuSlovu,
		urlOdvozene,
		type Fotka,
		type Index,
	} from "../lib/fotky";
	import { priZmeneSirky, usporadejDoRadku, type PolozkaSPomerem } from "../lib/radky";

	// Kolik prvních fotek (po zamíchání) se má načíst hned, ne lazy — týká se
	// těch, co jsou vidět bez scrollování. Musí jich být dost na první řádek,
	// jinak se stránka při otevření zdánlivě otevře prázdná (viz zadání).
	// Přesný počet fotek v prvním řádku je proměnlivý (závisí na poměru stran),
	// 4 je bezpečná rezerva nad typickým počtem 3 z wireframu.
	const POCET_EAGER = 4;

	// Desktop: fotka v mřížce o 2-3 na řádek zabírá zhruba polovinu šířky.
	// Mobil: jeden sloupec, fotka na plnou šířku (viz .media-galerie v
	// global.css).
	const SIZES = "(max-width: 767px) 100vw, 50vw";

	// Sdílené přes všechny galerie na stránce — dneska je vždycky jedna, ale
	// kdyby jich bylo víc, `?foto=` se má zkusit otevřít jen jednou, ne v
	// každé z nich.
	let uzOtevreno = false;

	// Fisher-Yates — nové zamíchání při každém načtení stránky (rozhodnutí B0).
	function zamichej<T>(pole: T[]): T[] {
		const vysledek = pole.slice();
		for (let i = vysledek.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[vysledek[i], vysledek[j]] = [vysledek[j], vysledek[i]];
		}
		return vysledek;
	}

	// Alt text: kaskáda titulek → název galerie (rozhodnutí B2). Nikdy prázdný.
	function altText(fotka: Fotka, nazevGalerie: string): string {
		return fotka.titulek?.trim() || nazevGalerie;
	}

	function pridatMeta(rodic: HTMLElement, itemprop: string, obsah: string | null | undefined) {
		if (!obsah) return;
		const meta = document.createElement("meta");
		meta.setAttribute("itemprop", itemprop);
		meta.setAttribute("content", obsah);
		rodic.appendChild(meta);
	}

	function vytvorPolozku(
		fotka: Fotka,
		index: number,
		nazevGalerie: string,
		popisky: boolean,
	): HTMLAnchorElement {
		const sirka = fotka.rozmery!.sirka;
		const vyska = fotka.rozmery!.vyska;
		const url600 = urlOdvozene(fotka, 600)!;
		const url1200 = urlOdvozene(fotka, 1200)!;
		const url2048 = urlOdvozene(fotka, 2048)!;
		const alt = altText(fotka, nazevGalerie);

		const odkaz = document.createElement("a");
		odkaz.className = "media-galerie-polozka";
		odkaz.href = url2048;
		odkaz.target = "_blank";
		odkaz.rel = "noreferrer";
		// Napojení na PhotoSwipe (photoswipe/lightbox čte data-pswp-width/height
		// z anchoru přes children: 'a').
		odkaz.dataset.pswpWidth = String(sirka);
		odkaz.dataset.pswpHeight = String(vyska);
		odkaz.setAttribute("itemscope", "");
		odkaz.setAttribute("itemtype", "https://schema.org/ImageObject");

		const img = document.createElement("img");
		img.src = url600;
		img.srcset = `${url600} 600w, ${url1200} 1200w`;
		img.sizes = SIZES;
		img.width = sirka;
		img.height = vyska;
		// Viditelné bez scrollování nesmí být lazy, jinak se stránka otevře
		// zdánlivě prázdná.
		img.loading = index < POCET_EAGER ? "eager" : "lazy";
		img.decoding = "async";
		img.alt = alt;
		odkaz.appendChild(img);

		// ImageObject (schema.org) — vedlejší produkt dat, která index nese
		// stejně (viz architektura galerie). contentUrl ukazuje na plnou
		// velikost, ne na náhled v mřížce.
		pridatMeta(odkaz, "contentUrl", url2048);
		pridatMeta(odkaz, "creator", fotka.autor);
		pridatMeta(odkaz, "copyrightNotice", fotka.licence);
		pridatMeta(odkaz, "license", fotka.licence);
		pridatMeta(odkaz, "caption", alt);

		// Popisek fotky se ve fázi 5 na stránce galerie nezobrazuje
		// (rozhodnutí B1) — parametr `popisky` je připravený pro rozcestník.
		if (popisky && fotka.titulek) {
			const popisek = document.createElement("span");
			popisek.className = "media-galerie-popisek";
			popisek.textContent = fotka.titulek;
			odkaz.appendChild(popisek);
		}

		return odkaz;
	}

	async function vykresliGalerii(kontejner: HTMLElement, poradi: number) {
		const klicoveSlovo = kontejner.dataset.klicoveSlovo ?? "";
		const klicLower = klicoveSlovo.toLowerCase();
		const popisky = kontejner.dataset.popisky === "true";

		let index: Index;
		try {
			index = await nacistIndex();
		} catch (chyba) {
			// Skutečná selhání (síť, neplatný JSON) se logují — na rozdíl od
			// prázdného výsledku po filtrování, což je legitimní stav a chybu
			// v konzoli mít nesmí (viz „Hotovo, když" č. 6).
			console.error("[media-galerie] nepodařilo se načíst /api/index.json:", chyba);
			return;
		}

		const vsechnyFotky = Array.isArray(index.fotky) ? index.fotky : [];
		const shoda = vsechnyFotky.filter(
			(fotka) => odpovidaKlicovemuSlovu(fotka, klicLower) && jeZobrazitelna(fotka),
		);

		// Prázdná galerie je legitimní stav nové galerie bez nahraných fotek
		// (rozhodnutí B7) — žádná hláška, žádná chyba, prostě prázdné místo.
		if (shoda.length === 0) {
			return;
		}

		const nazevGalerie = document.querySelector("h1")?.textContent?.trim() || klicoveSlovo;
		const promichane = zamichej(shoda);

		const polozky: PolozkaSPomerem[] = promichane.map((fotka, i) => ({
			prvek: vytvorPolozku(fotka, i, nazevGalerie, popisky),
			pomer: fotka.rozmery!.sirka / fotka.rozmery!.vyska,
		}));

		if (!kontejner.id) {
			kontejner.id = `media-galerie-${poradi}`;
		}

		// Skládá fotky do zarovnaných řádků (viz src/lib/radky.ts) — dopočítává
		// se výška řádku, ne šířka fotky, takže se fotky jen zmenšují, nikdy
		// neořezávají. Musí proběhnout znovu při resize (jiná šířka kontejneru
		// = jiné složení řádků).
		const prekresli = () =>
			usporadejDoRadku(kontejner, polozky, "--galerie-radek-vyska", "--galerie-radek-mezera", "media-galerie-radek");
		prekresli();

		const lightbox = new PhotoSwipeLightbox({
			gallery: `#${kontejner.id}`,
			children: "a",
			pswpModule: () => import("photoswipe"),
			// Čistá černá plocha bez knihovních výchozích hodnot (viz global.css
			// pro barvu přes --pswp-bg) — bgOpacity 1 dělá pozadí neprůhledné.
			bgOpacity: 1,
			// Stažení zůstává vypnuté — v jádru PhotoSwipe v5 není žádné
			// tlačítko stažení, jen se sem záměrně nepřidává (žádný plugin).
		});
		lightbox.init();

		// Odkaz sdílený z OG meta tagů (server/ogFoto.js) vede na
		// `<cesta-galerie>/?foto=<klíč>` — po načtení stránky rovnou otevřít
		// lightbox na téhle fotce, ne nechat návštěvníka hledat ji v mřížce.
		const klicZUrl = new URLSearchParams(location.search).get("foto");
		if (klicZUrl && !uzOtevreno) {
			// Index MUSÍ být z `promichane` (zamíchané pořadí, ve kterém se
			// skutečně vykresluje DOM) — index z nezamíchaného zdrojového pole
			// by otevřel náhodně jinou fotku.
			const idx = promichane.findIndex((f) => f.klic === klicZUrl);
			if (idx >= 0) {
				uzOtevreno = true;
				lightbox.loadAndOpen(idx);
			}
			// idx < 0: tichý no-op, žádný console.error — překlep v URL, smazaná
			// fotka nebo fotka z jiné galerie jsou legitimní stavy (stejné
			// pravidlo jako zbytek repa: prázdný výsledek není chyba).
		}

		// Po zavření lightboxu odstranit `?foto=` z adresního řádku — jinak by
		// reload nebo návrat tlačítkem zpět otevíral lightbox znovu pořád
		// dokola. replaceState, ne pushState (nepřidávat novou položku historie).
		lightbox.on("close", () => history.replaceState({}, "", location.pathname));

		priZmeneSirky(prekresli);
	}

	document.querySelectorAll<HTMLElement>(".media-galerie").forEach((kontejner, poradi) => {
		vykresliGalerii(kontejner, poradi);
	});
</script>
